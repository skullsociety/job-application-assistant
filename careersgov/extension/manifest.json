{
  "manifest_version": 3,
  "name": "Careers@Gov Assistant",
  "version": "0.12.1",
  "key": "",
  "description": "Capture Careers@Gov jobs and locally autofill known Workday application fields for review.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://jobs.careers.gov.sg/*",
    "https://sggovterp.wd102.myworkdayjobs.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8767/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.sapsf.com/*",
    "https://*.sapsf.eu/*",
    "https://*.sapsf.cn/*",
    "https://*.hr.cloud.sap/*",
    "https://*.jobs.hr.cloud.sap.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Careers@Gov Assistant"
  },
  "options_page": "autofill-profile.html",
  "commands": {
    "capture-current-job": {
      "suggested_key": {
        "windows": "Ctrl+Q"
      },
      "description": "Capture the current Careers@Gov job"
    },
    "open-local-dashboard": {
      "suggested_key": {
        "windows": "Ctrl+M"
      },
      "description": "Open the shared job dashboard"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.careers.gov.sg/*"
      ],
      "js": [
        "capture-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.sapsf.com/*",
        "https://*.sapsf.eu/*",
        "https://*.sapsf.cn/*",
        "https://*.hr.cloud.sap/*",
        "https://*.jobs.hr.cloud.sap.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": [
        "successfactors-core.js",
        "successfactors-autofill.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
