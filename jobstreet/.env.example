# Optional portable data root. GitHub clones default to the project folder.
# JOB_ASSISTANT_HOME=C:\path\to\jobstreet

# Override automatic sibling-project discovery when LinkedIn is elsewhere.
# JOBSTREET_LINKEDIN_PROJECT_DIR=C:\path\to\linkedin

# Set to false to keep a separate JobStreet database.
# JOBSTREET_SHARE_LINKEDIN_TRACKER=true

# Optional folder containing PDF/DOCX resumes. The newest file is used.
# JOB_ASSISTANT_RESUME_DIR=C:\path\to\resumes
