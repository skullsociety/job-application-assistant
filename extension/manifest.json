{
  "manifest_version": 3,
  "name": "Unified Job Application Assistant",
  "version": "3.0.22",
  "key": "",
  "description": "Capture LinkedIn, JobStreet and Careers@Gov jobs, then track and autofill applications locally.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://jobstreet.com/*",
    "https://*.jobstreet.com/*",
    "https://jobstreet.com.sg/*",
    "https://*.jobstreet.com.sg/*",
    "https://jobs.careers.gov.sg/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.sapsf.com/*",
    "https://*.sapsf.eu/*",
    "https://*.sapsf.cn/*",
    "https://*.hr.cloud.sap/*",
    "https://*.jobs.hr.cloud.sap.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Unified Job Application Assistant"
  },
  "options_page": "autofill-profile.html",
  "commands": {
    "capture-current-job": {
      "suggested_key": {
        "windows": "Ctrl+Q"
      },
      "description": "Capture the current supported job listing"
    },
    "open-local-dashboard": {
      "suggested_key": {
        "windows": "Ctrl+M"
      },
      "description": "Open the unified local job dashboard"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["sites/linkedin/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobstreet.com/*",
        "https://*.jobstreet.com/*",
        "https://jobstreet.com.sg/*",
        "https://*.jobstreet.com.sg/*"
      ],
      "js": ["sites/jobstreet/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jobs.careers.gov.sg/*"],
      "js": ["sites/careersgov/capture-core.js", "sites/careersgov/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.sapsf.com/*",
        "https://*.sapsf.eu/*",
        "https://*.sapsf.cn/*",
        "https://*.hr.cloud.sap/*",
        "https://*.jobs.hr.cloud.sap.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["successfactors-core.js", "successfactors-autofill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
