# Private user data (database, resumes, exports, autofill answers, browser state, logs)
/local-data/

# Local runtimes and generated files
/.venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/node_modules/
/chrome-helper/generated/

# User-specific settings and secrets
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/config.toml
**/*.local.json
**/private/
**/profile.json

# Legacy/generated platform locations (current data belongs in local-data)
/linkedin/data/
/linkedin/exports/
/linkedin/logs/
/linkedin/resumes/
/linkedin/tmp/
/linkedin/native-messaging/
/jobstreet/data/
/jobstreet/exports/
/jobstreet/logs/
/jobstreet/resumes/
/jobstreet/tmp/
/jobstreet/native-messaging/
/careersgov/data/
/careersgov/exports/
/careersgov/resumes/
/careersgov/tailored_resumes/

# Documents and databases must never be published from source folders
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.pdf
**/*.docx
**/*.xlsx

# Workspace scratch output
**/tmp/
**/output/
**/*preview.png

# Shared extension assets are generated by setup from shared_tracker/extension
/extension/autofill-profile.css
/extension/autofill-profile.html
/extension/autofill-profile.js
/extension/native-lifecycle.js
/extension/successfactors-autofill.js
/extension/successfactors-core.js
/extension/successfactors-worker.js
